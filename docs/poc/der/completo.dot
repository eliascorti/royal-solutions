digraph DER {
graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.35", ranksep="1.0", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=9, color="#6F8090", arrowsize=0.7];
USUARIO [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B5C4CF"><TR><TD BGCOLOR="#174765"><FONT COLOR="white"><B>USUARIO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FA">PK id<BR ALIGN="LEFT"/>UK email; DNI si informado<BR ALIGN="LEFT"/>nombre; apellido; telefono<BR ALIGN="LEFT"/>credencial_local; roles; estado<BR ALIGN="LEFT"/>preferencias; creado_en<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
PRESTADOR [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B5C4CF"><TR><TD BGCOLOR="#174765"><FONT COLOR="white"><B>PRESTADOR</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FA">PK id<BR ALIGN="LEFT"/>FK UK usuario_id<BR ALIGN="LEFT"/>descripcion; tags; estado<BR ALIGN="LEFT"/>disponible; coordenadas_base<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
RUBRO [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B5C4CF"><TR><TD BGCOLOR="#174765"><FONT COLOR="white"><B>RUBRO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FA">PK id<BR ALIGN="LEFT"/>nombre; especialidades<BR ALIGN="LEFT"/>comision_pct_interna<BR ALIGN="LEFT"/>requisitos_documentales<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
PRESTADOR_RUBRO [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B5C4CF"><TR><TD BGCOLOR="#174765"><FONT COLOR="white"><B>PRESTADOR_RUBRO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FA">PK FK prestador_id<BR ALIGN="LEFT"/>PK FK rubro_id<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
BARRIO [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B5C4CF"><TR><TD BGCOLOR="#174765"><FONT COLOR="white"><B>BARRIO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FA">PK id<BR ALIGN="LEFT"/>nombre; x; y<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
COBERTURA [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B5C4CF"><TR><TD BGCOLOR="#174765"><FONT COLOR="white"><B>COBERTURA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FA">PK FK prestador_id<BR ALIGN="LEFT"/>PK FK barrio_id<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
DISPONIBILIDAD [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B5C4CF"><TR><TD BGCOLOR="#174765"><FONT COLOR="white"><B>DISPONIBILIDAD</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FA">PK FK prestador_id<BR ALIGN="LEFT"/>PK dia_semana<BR ALIGN="LEFT"/>PK franja<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
DOCUMENTO [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B5C4CF"><TR><TD BGCOLOR="#174765"><FONT COLOR="white"><B>DOCUMENTO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FA">PK id<BR ALIGN="LEFT"/>FK prestador_id<BR ALIGN="LEFT"/>FK rubro_id (opcional)<BR ALIGN="LEFT"/>tipo; numero; entidad; vence<BR ALIGN="LEFT"/>archivo; estado; motivo<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
DIRECCION [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B5C4CF"><TR><TD BGCOLOR="#174765"><FONT COLOR="white"><B>DIRECCION</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FA">PK id_logico<BR ALIGN="LEFT"/>FK usuario_id; FK barrio_id<BR ALIGN="LEFT"/>alias; calle; x; y<BR ALIGN="LEFT"/>id_local dentro del usuario<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
SOLICITUD [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B5C4CF"><TR><TD BGCOLOR="#174765"><FONT COLOR="white"><B>SOLICITUD</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FA">PK id<BR ALIGN="LEFT"/>FK cliente_id; FK rubro_id<BR ALIGN="LEFT"/>descripcion; domicilio_copia<BR ALIGN="LEFT"/>urgente; fecha; franja<BR ALIGN="LEFT"/>presupuesto_ref; estado<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
FOTO_SOLICITUD [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B5C4CF"><TR><TD BGCOLOR="#174765"><FONT COLOR="white"><B>FOTO_SOLICITUD</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FA">PK FK solicitud_id<BR ALIGN="LEFT"/>PK posicion<BR ALIGN="LEFT"/>archivo<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
POSTULACION [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B5C4CF"><TR><TD BGCOLOR="#174765"><FONT COLOR="white"><B>POSTULACION</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FA">PK id<BR ALIGN="LEFT"/>FK solicitud_id<BR ALIGN="LEFT"/>FK prestador_id<BR ALIGN="LEFT"/>precio; mensaje; fecha; franja<BR ALIGN="LEFT"/>UK solicitud + prestador<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ORDEN [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B5C4CF"><TR><TD BGCOLOR="#174765"><FONT COLOR="white"><B>ORDEN</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FA">PK id<BR ALIGN="LEFT"/>FK cliente_id; prestador_id<BR ALIGN="LEFT"/>FK rubro_id<BR ALIGN="LEFT"/>FK solicitud_id (opcional)<BR ALIGN="LEFT"/>FK postulacion_id (opcional)<BR ALIGN="LEFT"/>domicilio_copia; fecha; franja<BR ALIGN="LEFT"/>precio; monto_final; estado<BR ALIGN="LEFT"/>comision_pct; ejecutada<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
PAGO [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B5C4CF"><TR><TD BGCOLOR="#174765"><FONT COLOR="white"><B>PAGO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FA">PK id<BR ALIGN="LEFT"/>FK UK orden_id<BR ALIGN="LEFT"/>medio; monto; comision<BR ALIGN="LEFT"/>estado; referencia<BR ALIGN="LEFT"/>comprobante; historial<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
MOVIMIENTO [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B5C4CF"><TR><TD BGCOLOR="#174765"><FONT COLOR="white"><B>MOVIMIENTO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FA">PK id<BR ALIGN="LEFT"/>FK prestador_id<BR ALIGN="LEFT"/>FK orden_id (opcional)<BR ALIGN="LEFT"/>tipo; monto; fecha; detalle<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
RESENA [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B5C4CF"><TR><TD BGCOLOR="#174765"><FONT COLOR="white"><B>RESENA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FA">PK id<BR ALIGN="LEFT"/>FK orden_id<BR ALIGN="LEFT"/>FK autor_id; destinatario_id<BR ALIGN="LEFT"/>puntuacion; comentario; tags<BR ALIGN="LEFT"/>estado; fecha<BR ALIGN="LEFT"/>UK orden + autor<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
REPORTE [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B5C4CF"><TR><TD BGCOLOR="#174765"><FONT COLOR="white"><B>REPORTE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FA">PK id<BR ALIGN="LEFT"/>FK orden_id<BR ALIGN="LEFT"/>FK autor_id<BR ALIGN="LEFT"/>motivo; descripcion; estado<BR ALIGN="LEFT"/>resolucion; fecha<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
EVIDENCIA [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B5C4CF"><TR><TD BGCOLOR="#174765"><FONT COLOR="white"><B>EVIDENCIA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FA">PK id_logico<BR ALIGN="LEFT"/>FK reporte_id; FK autor_id<BR ALIGN="LEFT"/>texto; foto; fecha<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
DENUNCIA_RESENA [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B5C4CF"><TR><TD BGCOLOR="#174765"><FONT COLOR="white"><B>DENUNCIA_RESENA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FA">PK FK resena_id<BR ALIGN="LEFT"/>FK denunciante_id<BR ALIGN="LEFT"/>motivo; fecha<BR ALIGN="LEFT"/>decision; observacion<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
MENSAJE [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B5C4CF"><TR><TD BGCOLOR="#174765"><FONT COLOR="white"><B>MENSAJE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FA">PK id<BR ALIGN="LEFT"/>FK orden_id; FK emisor_id<BR ALIGN="LEFT"/>texto; ocultado; leido; fecha<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
NOTIFICACION [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B5C4CF"><TR><TD BGCOLOR="#174765"><FONT COLOR="white"><B>NOTIFICACION</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FA">PK id<BR ALIGN="LEFT"/>FK usuario_id<BR ALIGN="LEFT"/>app; tipo; titulo; cuerpo<BR ALIGN="LEFT"/>ruta_destino; leida; fecha<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
TARJETA [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B5C4CF"><TR><TD BGCOLOR="#174765"><FONT COLOR="white"><B>TARJETA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FA">PK id<BR ALIGN="LEFT"/>FK usuario_id<BR ALIGN="LEFT"/>marca; ultimos_4; vencimiento<BR ALIGN="LEFT"/>token_ficticio<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
FAVORITO [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B5C4CF"><TR><TD BGCOLOR="#174765"><FONT COLOR="white"><B>FAVORITO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FA">PK FK cliente_id<BR ALIGN="LEFT"/>PK FK prestador_id<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
RECUPERACION [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B5C4CF"><TR><TD BGCOLOR="#174765"><FONT COLOR="white"><B>RECUPERACION</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FA">PK token<BR ALIGN="LEFT"/>FK usuario_id<BR ALIGN="LEFT"/>vence; usado<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
AUDITORIA [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B5C4CF"><TR><TD BGCOLOR="#174765"><FONT COLOR="white"><B>AUDITORIA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FA">PK id<BR ALIGN="LEFT"/>FK actor_id (opcional)<BR ALIGN="LEFT"/>rol; accion; entidad; entidad_id<BR ALIGN="LEFT"/>detalle; fecha<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
USUARIO -> PRESTADOR [label="usuario_id",dir=none,taillabel="1",headlabel="0..1",labeldistance=2.0];
USUARIO -> DIRECCION [label="usuario_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
BARRIO -> DIRECCION [label="barrio_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
PRESTADOR -> PRESTADOR_RUBRO [label="prestador_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
RUBRO -> PRESTADOR_RUBRO [label="rubro_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
PRESTADOR -> COBERTURA [label="prestador_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
BARRIO -> COBERTURA [label="barrio_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
PRESTADOR -> DISPONIBILIDAD [label="prestador_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
PRESTADOR -> DOCUMENTO [label="prestador_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
RUBRO -> DOCUMENTO [label="rubro_id",dir=none,taillabel="0..1",headlabel="0..N",labeldistance=2.0];
USUARIO -> SOLICITUD [label="cliente_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
RUBRO -> SOLICITUD [label="rubro_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
SOLICITUD -> FOTO_SOLICITUD [label="solicitud_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
SOLICITUD -> POSTULACION [label="solicitud_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
PRESTADOR -> POSTULACION [label="prestador_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
USUARIO -> ORDEN [label="cliente_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
PRESTADOR -> ORDEN [label="prestador_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
RUBRO -> ORDEN [label="rubro_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
SOLICITUD -> ORDEN [label="solicitud_id",dir=none,taillabel="0..1",headlabel="0..N",labeldistance=2.0];
POSTULACION -> ORDEN [label="postulacion_id",dir=none,taillabel="0..1",headlabel="0..N",labeldistance=2.0];
ORDEN -> PAGO [label="orden_id",dir=none,taillabel="1",headlabel="0..1",labeldistance=2.0];
PRESTADOR -> MOVIMIENTO [label="prestador_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
ORDEN -> MOVIMIENTO [label="orden_id",dir=none,taillabel="0..1",headlabel="0..N",labeldistance=2.0];
ORDEN -> RESENA [label="orden_id",dir=none,taillabel="1",headlabel="0..2",labeldistance=2.0];
USUARIO -> RESENA [label="autor_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
USUARIO -> RESENA [label="destinatario_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
ORDEN -> REPORTE [label="orden_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
USUARIO -> REPORTE [label="autor_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
REPORTE -> EVIDENCIA [label="reporte_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
USUARIO -> EVIDENCIA [label="autor_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
RESENA -> DENUNCIA_RESENA [label="resena_id",dir=none,taillabel="1",headlabel="0..1",labeldistance=2.0];
USUARIO -> DENUNCIA_RESENA [label="denunciante_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
ORDEN -> MENSAJE [label="orden_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
USUARIO -> MENSAJE [label="emisor_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
USUARIO -> NOTIFICACION [label="usuario_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
USUARIO -> TARJETA [label="usuario_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
USUARIO -> FAVORITO [label="cliente_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
PRESTADOR -> FAVORITO [label="prestador_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
USUARIO -> RECUPERACION [label="usuario_id",dir=none,taillabel="1",headlabel="0..N",labeldistance=2.0];
USUARIO -> AUDITORIA [label="actor_id",dir=none,taillabel="0..1",headlabel="0..N",labeldistance=2.0];
}
